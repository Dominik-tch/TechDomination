{
  // Wirtschaftsregeln. Alle Werte sind Platzhalter fürs Balancing.
  // Produktion und Steuern werden alle "intervalTicks" Ticks gutgeschrieben (10 Ticks = 1 Sekunde bei "normal").
  "intervalTicks": 10,

  // Geld pro Provinz und Takt, unabhängig von der Provinzgröße. Höchstens 2 Nachkommastellen.
  "taxPerProvince": 2.5,

  // Jede Nation startet mit diesen Beständen. Ressourcen höchstens 3 Nachkommastellen.
  "startMoney": 4000,

  // Fabriken machen nur alle so viele Wirtschaftstakte einen Durchlauf je Stufe (Rezepte siehe buildings.json).
  "factoryCycleIntervals": 4,

  // Stärkeverlust der Einheiten pro Takt, wenn ihr Unterhalt (siehe units.json) vollständig fehlt; bei Teilmangel anteilig.
  // 0,1 % pro Takt: Eine unversorgte Einheit löst sich nach etwa 17 Minuten bei "normal" auf.
  "shortageStrengthLossPercent": 0.1,
  "startResources": {
    "wood": 400,
    "steel": 400,
    "grain": 400,
    "fish": 400,
    "gas": 400,
    "coal": 400,
    "oil": 400,
    // Damit die Start-Armeen versorgt sind, bis eine Konservenfabrik läuft.
    "cannedFood": 200
  }
}
